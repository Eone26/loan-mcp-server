          "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"result\": {\n    \"tools\": [\n      {\n        \"name\": \"full_emi_schedule\",\n        \"description\": \"Generates a complete EMI repayment schedule for every month of the loan tenure. Returns a JSON array with one entry per month containing month number, date, EMI, principal, interest and balance. Required: loanAmount, interestRate, tenureMonths, startDate.\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"loanAmount\": {\n              \"type\": \"string\",\n              \"description\": \"Loan principal amount\"\n            },\n            \"interestRate\": {\n              \"type\": \"string\",\n              \"description\": \"Annual interest rate as a percentage (e.g. 8.5)\"\n            },\n            \"tenureMonths\": {\n              \"type\": \"string\",\n              \"description\": \"Loan tenure in months (e.g. 60)\"\n            },\n            \"startDate\": {\n              \"type\": \"string\",\n              \"description\": \"Loan start date in YYYY-MM-DD format\"\n            }\n          },\n          \"required\": [\n            \"loanAmount\",\n            \"interestRate\",\n            \"tenureMonths\",\n            \"startDate\"\n          ]\n        }\n      },\n      {\n        \"name\": \"validate_missing_fields\",\n        \"description\": \"Analyses an agent response (with schema and data) and returns a job_id immediately. The AI agent runs asynchronously. Poll get_job_result with the job_id to retrieve the result. Required: Questions (JSON list), Request (JSON agent response).\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"Questions\": {\n              \"type\": \"string\",\n              \"description\": \"JSON list of question items [{tablename, attrName, question}]\"\n            },\n            \"Request\": {\n              \"type\": \"string\",\n              \"description\": \"JSON agent response with schema and data objects\"\n            }\n          },\n          \"required\": [\n            \"Questions\",\n            \"Request\"\n          ]\n        }\n      },\n      {\n        \"name\": \"get_job_result\",\n        \"description\": \"Polls the result of an async MCP job. Returns status (pending/done/error) and the result JSON when done. Use after calling validate_missing_fields.\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"job_id\": {\n              \"type\": \"string\",\n              \"description\": \"The job_id returned by validate_missing_fields\"\n            }\n          },\n          \"required\": [\n            \"job_id\"\n          ]\n        }\n      }\n    ]\n  }\n}"
        }
      ]
